{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hook.js\" start", "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hook.js\" prompt", "timeout": 5 }] }
    ],
    "PreToolUse": [
      { "matcher": "mcp__plugin_status-page_status__.*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hook.js\" allow", "timeout": 5 }] },
      { "matcher": "Agent|Task", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hook.js\" helper", "timeout": 5 }] },
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hook.js\" pre", "async": true }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hook.js\" substart", "async": true }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hook.js\" substop", "async": true }] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hook.js\" post", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hook.js\" stop", "timeout": 5 },
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hook.js\" wait", "asyncRewake": true }
      ] }
    ]
  }
}
